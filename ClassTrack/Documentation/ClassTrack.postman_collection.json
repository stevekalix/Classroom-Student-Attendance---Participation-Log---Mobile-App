    "info":  {
                 "description":  "Run in order. A new teacher and student are created; the last requests delete the note and archive the student. Clear email and rollId collection variables for a fresh run.",
                 "name":  "ClassTrack API",
                 "schema":  "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
             },
    "event":  [
                  {
                      "script":  {
                                     "exec":  [
                                                  "if (!pm.collectionVariables.get(\"email\")) pm.collectionVariables.set(\"email\", \"teacher\" + Date.now() + \"@example.com\");",
                                                  "if (!pm.collectionVariables.get(\"rollId\")) pm.collectionVariables.set(\"rollId\", \"CSE\" + Date.now());",
                                                  "if (!pm.collectionVariables.get(\"date\")) pm.collectionVariables.set(\"date\", new Date().toISOString().slice(0, 10));"
                                              ],
                                     "type":  "text/javascript"
                                 },
                      "listen":  "prerequest"
                  }
              ],
    "auth":  {
                 "bearer":  [
